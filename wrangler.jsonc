// valkey.app marketing site: static assets only (no Worker script).
// _site is assembled by .github/workflows/deploy-website.yml.
{
  "name": "valkey-app-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site"
  },
  "routes": [
    { "pattern": "valkey.app", "custom_domain": true },
    { "pattern": "www.valkey.app", "custom_domain": true }
  ],
  // Required by `wrangler preview` (Workers Builds non-production branch deploys); empty is fine.
  "previews": {},
  // Keep on: every deploy re-applies these, and scripts/build-site.sh fails the build if they are removed.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
